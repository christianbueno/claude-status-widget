{
  "name": "claude-status-widget",
  "version": "1.0.0",
  "description": "Floating macOS widget for Claude system status",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4"
  },
  "build": {
    "appId": "com.claude.status-widget",
    "productName": "Claude Status",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": "dmg"
    }
  }
}
